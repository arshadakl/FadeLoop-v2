{
  "name": "fadeloop-v2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "pnpm --filter @fadeloop/web dev",
    "dev:api": "pnpm --filter @fadeloop/api dev",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.tools.json && pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "hooks:install": "git config core.hooksPath .githooks",
    "commits:check": "node scripts/check-commits.mjs",
    "meta:check": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=apps/api/.dev.vars scripts/meta-readiness.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/workers-types": "5.20261029.1",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  }
}
