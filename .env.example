# No browser credentials or API base URL are required for the local foundation.
# Vite proxies /api to http://127.0.0.1:8787. Never place Meta secrets in VITE_* variables.

# Server-only P02 setup. Existing APP_ID/APP_SECRET/WEBHOOK_VERIFY_TOKEN aliases
# are accepted by pnpm meta:check. Confirm they belong to Instagram Login.
META_APP_ID=<instagram-app-id>
META_APP_SECRET=<instagram-app-secret>
META_WEBHOOK_SIGNING_SECRET=<confirmed-webhook-signing-secret>
META_WEBHOOK_VERIFY_TOKEN=<random-verification-token>
# Legacy-compatible baseline; confirm current provider support during P02.
META_GRAPH_VERSION=v23.0
META_REDIRECT_URI=https://your-v2-test-domain.example/auth/callback
TOKEN_ENCRYPTION_KEY=<32-byte-base64url-key>
