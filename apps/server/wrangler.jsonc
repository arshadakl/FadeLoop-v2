{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fadeloop",
  "account_id": "d2d71c52d0381df127528c8919382eb7",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "production"
  },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fadeloop-d1",
      "database_id": "0ed5b3ff-2f78-4c2e-88e6-1b283649318f"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INCOMING_EVENTS_QUEUE",
        "queue": "fadeloop-incoming-events"
      }
    ],
    "consumers": [
      {
        "queue": "fadeloop-incoming-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "fadeloop-incoming-events-dlq"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "10301",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "env": {
    "test": {
      "name": "fadeloop-test",
      "vars": { "APP_ENV": "test" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fadeloop-d1",
          "database_id": "0ed5b3ff-2f78-4c2e-88e6-1b283649318f"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "INCOMING_EVENTS_QUEUE",
            "queue": "fadeloop-incoming-events"
          }
        ],
        "consumers": [
          {
            "queue": "fadeloop-incoming-events",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "fadeloop-incoming-events-dlq"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "LOGIN_RATE_LIMITER",
          "namespace_id": "10301",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  }
}
