{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fadeloop-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "APP_ENV": "local", "APP_ORIGIN": "http://127.0.0.1:5173" },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "10301",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fadeloop-local",
      "migrations_dir": "../../schema"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INCOMING_EVENTS_QUEUE",
        "queue": "fadeloop-incoming-events"
      }
    ],
    "consumers": [
      {
        "queue": "fadeloop-incoming-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "fadeloop-incoming-events-dlq"
      }
    ]
  }
}
