{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fadeloop-ingress-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "APP_ENV": "local" },
  "env": {
    "test": { "name": "fadeloop-ingress-test", "vars": { "APP_ENV": "test" } },
    "production": {
      "name": "fadeloop-ingress",
      "vars": { "APP_ENV": "production" }
    }
  }
}
