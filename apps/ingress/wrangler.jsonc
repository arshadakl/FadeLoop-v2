{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fadeloop-ingress",
  "account_id": "d2d71c52d0381df127528c8919382eb7",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "production"
  },
  "queues": {
    "producers": [
      {
        "binding": "INCOMING_EVENTS_QUEUE",
        "queue": "fadeloop-incoming-events"
      }
    ]
  },
  "env": {
    "test": {
      "name": "fadeloop-ingress-test",
      "vars": { "APP_ENV": "test" },
      "queues": {
        "producers": [
          {
            "binding": "INCOMING_EVENTS_QUEUE",
            "queue": "fadeloop-incoming-events"
          }
        ]
      }
    }
  }
}
