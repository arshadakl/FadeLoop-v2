{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fadeloop-consumer",
  "account_id": "d2d71c52d0381df127528c8919382eb7",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fadeloop-d1",
      "database_id": "0ed5b3ff-2f78-4c2e-88e6-1b283649318f"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "fadeloop-incoming-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "fadeloop-incoming-events-dlq"
      }
    ]
  },
  "env": {
    "test": {
      "name": "fadeloop-consumer-test",
      "vars": { "APP_ENV": "test" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fadeloop-d1",
          "database_id": "0ed5b3ff-2f78-4c2e-88e6-1b283649318f"
        }
      ],
      "queues": {
        "consumers": [
          {
            "queue": "fadeloop-incoming-events",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "fadeloop-incoming-events-dlq"
          }
        ]
      }
    }
  }
}
