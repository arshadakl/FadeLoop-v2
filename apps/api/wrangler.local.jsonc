{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fadeloop-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "APP_ENV": "local", "APP_ORIGIN": "http://127.0.0.1:5173" },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "10301",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fadeloop-local",
      "migrations_dir": "../../schema"
    }
  ]
}
