{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fadeloop-api",
  "account_id": "d2d71c52d0381df127528c8919382eb7",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fadeloop-d1",
      "database_id": "0ed5b3ff-2f78-4c2e-88e6-1b283649318f"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "10301",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "env": {
    "test": {
      "name": "fadeloop-api-test",
      "vars": { "APP_ENV": "test" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fadeloop-d1",
          "database_id": "0ed5b3ff-2f78-4c2e-88e6-1b283649318f"
        }
      ],
      "ratelimits": [
        {
          "name": "LOGIN_RATE_LIMITER",
          "namespace_id": "10301",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  }
}
